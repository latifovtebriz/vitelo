# ──────────────────────────────────────
# Vitelo Environment Variables Template
# Copy to .env and fill real values
# ──────────────────────────────────────

# Database (Neon.tech PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:pass@host/neondb?ssl=require

# Redis (Upstash)
REDIS_URL=rediss://default:password@host.upstash.io:6379

# JWT Auth
SECRET_KEY=change-me-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI (Gemini only)
GEMINI_API_KEY=

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=vitelo-pdfs
R2_PUBLIC_URL=https://r2.vitelo.me

# App
ENVIRONMENT=production
FRONTEND_URL=https://vitelo.me
API_URL=https://api.vitelo.me
